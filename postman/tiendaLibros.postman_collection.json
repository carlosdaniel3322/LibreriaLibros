  "item": [
    {
      "name": "Autenticacion JWT",
      "item": [
        {
          "name": "1. Login LECTOR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Debe responder 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const respuesta = pm.response.json();",
                  "pm.test('Debe devolver un token JWT', function () {",
                  "    pm.expect(respuesta.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('lectorToken', respuesta.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"lector\",\n  \"password\": \"lector123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
