{
  "info": {
    "_postman_id": "3bfe9d47-bb1f-4e4b-91df-9d8f9b7a0111",
    "name": "tiendaLibros",
    "description": "Coleccion con pruebas automaticas para Libros y Revistas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Libros",
      "item": [
        {
          "name": "1. Listar libros",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Debe responder 200', function () {", "    pm.response.to.have.status(200);", "});", "pm.test('Debe devolver una lista', function () {", "    pm.expect(pm.response.json()).to.be.an('array');", "});"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/libros" }
        },
        {
          "name": "2. Crear libro",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Debe responder 201', function () {", "    pm.response.to.have.status(201);", "});", "const libro = pm.response.json();", "pm.test('Debe devolver el libro creado', function () {", "    pm.expect(libro.titulo).to.eql('Clean Code');", "    pm.expect(libro.id).to.be.a('number');", "});", "pm.collectionVariables.set('libroId', libro.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Clean Code\",\n  \"autor\": \"Robert C. Martin\",\n  \"isbn\": \"9780132350884\",\n  \"precio\": 50.00,\n  \"stock\": 3\n}" },
            "url": "{{baseUrl}}/api/libros"
          }
        },
        {
          "name": "3. Obtener libro por id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Debe responder 200', function () {", "    pm.response.to.have.status(200);", "});", "pm.test('Debe devolver el libro correcto', function () {", "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('libroId')));", "});"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/libros/{{libroId}}" }
        },
        {
          "name": "4. Actualizar libro",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Debe responder 200', function () {", "    pm.response.to.have.status(200);", "});", "pm.test('Debe actualizar el titulo', function () {", "    pm.expect(pm.response.json().titulo).to.eql('Clean Code 2da Edicion');", "});"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Clean Code 2da Edicion\",\n  \"autor\": \"Robert C. Martin\",\n  \"isbn\": \"9780132350884\",\n  \"precio\": 55.00,\n  \"stock\": 4\n}" },
            "url": "{{baseUrl}}/api/libros/{{libroId}}"
          }
        },
        {
          "name": "5. Eliminar libro",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Debe responder 204', function () {", "    pm.response.to.have.status(204);", "});"] } }],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/libros/{{libroId}}" }
        },
        {
          "name": "Error 404 libro inexistente",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Debe responder 404', function () {", "    pm.response.to.have.status(404);", "});"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/libros/999999" }
        },
        {
          "name": "Error 400 libro invalido",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Debe responder 400', function () {", "    pm.response.to.have.status(400);", "});"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"\",\n  \"autor\": \"\",\n  \"isbn\": \"123\",\n  \"precio\": -1,\n  \"stock\": -2\n}" },
            "url": "{{baseUrl}}/api/libros"
          }
        }
      ]
    },
    {
