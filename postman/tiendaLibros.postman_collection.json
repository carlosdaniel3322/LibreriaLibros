    {
      "name": "Libros",
      "item": [
        {
          "name": "1. Listar libros",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Debe responder 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Debe devolver una lista', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/libros",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lectorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "2. Crear libro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Debe responder 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const libro = pm.response.json();",
                  "pm.test('Debe devolver el libro creado', function () {",
                  "    pm.expect(libro.titulo).to.eql('Clean Code');",
                  "    pm.expect(libro.id).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('libroId', libro.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Clean Code\",\n  \"autor\": \"Robert C. Martin\",\n  \"isbn\": \"9780132350884\",\n  \"precio\": 50.00,\n  \"stock\": 3\n}"
            },
            "url": "{{baseUrl}}/api/libros",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{editorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "3. Obtener libro por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Debe responder 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Debe devolver el libro correcto', function () {",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('libroId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/libros/{{libroId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lectorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Buscar libros por titulo o autor (JPQL)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Debe responder 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Debe encontrar el libro creado', function () {",
                  "    pm.expect(pm.response.json()[0].titulo).to.eql('Clean Code');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/libros/buscar?texto=clean",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lectorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "4. Actualizar libro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Debe responder 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Debe actualizar el titulo', function () {",
                  "    pm.expect(pm.response.json().titulo).to.eql('Clean Code 2da Edicion');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Clean Code 2da Edicion\",\n  \"autor\": \"Robert C. Martin\",\n  \"isbn\": \"9780132350884\",\n  \"precio\": 55.00,\n  \"stock\": 4\n}"
            },
            "url": "{{baseUrl}}/api/libros/{{libroId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{editorToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "5. Eliminar libro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Debe responder 204', function () {",
